                <gradient
                    android:endX="512"
                    android:endY="512"
                    android:startX="0"
                    android:startY="0"
                    android:type="linear">
                    <item
                        android:color="#15570F"
                        android:offset="0" />
                    <item
                        android:color="#3B618C"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Camera mount -->
        <path
            android:fillColor="#C6C6C6"
            android:pathData="M114,230 L286,230 C288,230 290,232 290,234 L290,250 C290,252 288,254 286,254 L114,254 C112,254 110,252 110,250 L110,234 C110,232 112,230 114,230 Z" />

