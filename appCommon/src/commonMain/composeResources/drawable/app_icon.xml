            android:pathData="M265,239.5 a2.5,2.5 0 1 0 0,5 a2.5,2.5 0 1 0 0,-5 Z" />

        <!-- Diamond fill -->
        <path android:pathData="M270,260 L410,260 L445,300 L340,425 L235,300 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="340"
                    android:endY="425"
                    android:startX="340"
                    android:startY="260"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0" />
                    <item
                        android:color="#FF6DAFC3"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Diamond facet lines -->
        <path
            android:fillColor="#00000000"
            android:pathData="M235,300 L445,300"
            android:strokeWidth="2.5"
            android:strokeAlpha="0.6"
            android:strokeColor="#3B618C" />
        <path
            android:fillColor="#00000000"
            android:pathData="M270,260 L340,425"
            android:strokeWidth="2.5"
            android:strokeAlpha="0.6"
            android:strokeColor="#3B618C" />
        <path
            android:fillColor="#00000000"
            android:pathData="M410,260 L340,425"
            android:strokeWidth="2.5"
            android:strokeAlpha="0.6"
            android:strokeColor="#3B618C" />

        <!-- Diamond outline -->
        <path
            android:fillColor="#00000000"
            android:pathData="M270,260 L410,260 L445,300 L340,425 L235,300 Z"
            android:strokeWidth="3"
            android:strokeColor="#3B618C"
            android:strokeLineJoin="round" />

        <!-- Crown highlight -->
        <path
            android:fillAlpha="0.5"
            android:fillColor="#FFFFFF"
            android:pathData="M270,260 L340,260 L290,300 Z" />
    </group>
