<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group>
        <clip-path android:pathData="M128,0 L384,0 C480,0 512,32 512,128 L512,384 C512,480 480,512 384,512 L128,512 C32,512 0,480 0,384 L0,128 C0,32 32,0 128,0 Z" />

        <path android:pathData="M0,0 L512,0 L512,512 L0,512 Z">
