        <!-- Lens outer ring (offset toward gem to indicate aim) -->
        <path
            android:fillColor="#3B618C"
            android:pathData="M230,154 a36,36 0 1 0 0,72 a36,36 0 1 0 0,-72 Z" />

        <!-- Lens mid -->
        <path
            android:fillColor="#0D3309"
            android:pathData="M230,162 a28,28 0 1 0 0,56 a28,28 0 1 0 0,-56 Z" />

        <!-- Lens inner -->
        <path
            android:fillColor="#1F1F1F"
            android:pathData="M230,173 a17,17 0 1 0 0,34 a17,17 0 1 0 0,-34 Z" />

        <!-- Lens glint -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M210,174.5 a6,3.5 0 1 0 0,7 a6,3.5 0 1 0 0,-7 Z" />

        <!-- Mount screws -->
        <path
            android:fillColor="#1F1F1F"
            android:pathData="M135,239.5 a2.5,2.5 0 1 0 0,5 a2.5,2.5 0 1 0 0,-5 Z" />
        <path
